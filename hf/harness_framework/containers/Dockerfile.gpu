# Build explicitly; network access is permitted during image construction only:
# docker build -f containers/Dockerfile.gpu -t hf-harness-gpu:local .
# Strict GPU execution requires Nsight Systems with CUDA/NVTX support. Use an
# administrator-provided BASE_IMAGE containing nsys, or configure nsys_mount
# (trusted host installation, read-only) and nsys_path. The executor refuses
# missing nsys and never silently substitutes Python hook evidence.
ARG BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && python3 -m venv /opt/hf-python \
    && /opt/hf-python/bin/python -m pip install --no-cache-dir numpy==2.2.6 scipy==1.15.3 cupy-cuda12x==13.6.0 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/hf-python/bin:$PATH PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
USER 65532:65532
WORKDIR /tmp
# No candidate, basis/integral generator, PySCF, reference or verifier is baked in.
CMD ["python3", "-c", "import cupy; print(cupy.__version__)"]
