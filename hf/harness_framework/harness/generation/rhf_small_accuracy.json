{
  "schema_version": 1,
  "name": "rhf-small-accuracy-v1",
  "method": "RHF",
  "description": "Single-shot generation gate: one generated program per run, CPU/NumPy only, correctness against trusted PySCF references on small closed-shell molecules. No large systems, no timing or speedup gate, no GPU stage.",
  "dependency_boundary": {
    "integrals": "trusted PySCF worker",
    "candidate_allowed_imports": [
      "__future__",
      "collections",
      "dataclasses",
