      "itertools",
      "math",
      "numbers",
      "numpy",
      "operator",
      "scipy",
      "typing",
      "warnings"
    ],
    "candidate_forbidden": [
      "pyscf",
      "gpu_hf",
      "reference files",
      "validation code"
    ],
    "generated_scope": [
      "build_jk",
      "solve"
    ]
  },
  "integral_modes": [
    "exact",
    "df"
  ],
  "auxbasis": "weigend",
  "tolerances": {
    "energy_max_abs": 1e-08,
    "jk_max_abs": 1e-09,
