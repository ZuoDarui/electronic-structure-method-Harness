{
  "name": "water-cluster-ccpvtz-jk",
  "description": "One RI-J plus COSX get_jk on 16, 32, 64, and 128 water molecules with cc-pVTZ. No SCF. 16 waters must finish and match PySCF density fitting. Larger sizes may be skipped when the estimated time exceeds the remaining task budget.",
  "command": ["python3", "harness_engineering/examples/water_cluster_jk_candidate.py"],
  "cases": [
    {"name": "water16-ccpvtz", "molecules": 16, "basis": "cc-pvtz"},
    {"name": "water32-ccpvtz", "molecules": 32, "basis": "cc-pvtz"},
    {"name": "water64-ccpvtz", "molecules": 64, "basis": "cc-pvtz"},
    {"name": "water128-ccpvtz", "molecules": 128, "basis": "cc-pvtz"}
  ],
  "correctness_tolerances": {
    "nao_mismatch_max": 0,
    "ri_j_16_max_abs": 2e-8,
    "j_parallel_16_max_abs": 2e-8,
    "k_parallel_16_max_abs": 2e-10,
    "j_asymmetry_16": 1e-8,
    "k_asymmetry_16": 1e-8,
    "cosx_monomer_max_abs": 2e-4,
    "cosx_full_tensor_calls": 0
  },
  "required_metrics": [
    "nao_16", "nao_32", "nao_64", "nao_128",
    "nao_mismatch_max", "all_finite",
    "significant_pair_fraction_16", "significant_pair_fraction_32",
    "significant_pair_fraction_64", "significant_pair_fraction_128",
    "memory_16_gib", "memory_32_gib", "memory_64_gib", "memory_128_gib",
    "ri_j_16_max_abs", "j_parallel_16_max_abs", "k_parallel_16_max_abs",
    "j_asymmetry_16", "k_asymmetry_16",
    "cosx_monomer_max_abs", "cosx_full_tensor_calls", "jk_16_s"
  ],
  "timeout_s": 3600
}
